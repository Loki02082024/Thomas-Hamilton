# ─── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public URL without trailing slash (used for VNPay return URL, sitemap, emails)
SITE_URL=http://localhost:3000
# Long random string — run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ─── Admin (/admin) ────────────────────────────────────────
ADMIN_EMAIL=quangcaohoanganh6688@gmail.com
# bcrypt hash — run: npm run hash-password -- "YourPassword"
ADMIN_PASSWORD_HASH=

# ─── MySQL (Hostinger hPanel → Databases → MySQL) ─────────
# Leave DB_HOST empty to store data in data/store.json (local development only)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ─── Email (Hostinger hPanel → Emails) ────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="THOMAS HAMILTON <no-reply@yourdomain.vn>"
# Where new-order and contact notifications go
ORDER_NOTIFY_EMAIL=quangcaohoanganh6688@gmail.com

# ─── VNPay ─────────────────────────────────────────────────
# Sandbox keys: register free at https://sandbox.vnpayment.vn/devreg/
# Leave VNPAY_TMN_CODE empty to hide the VNPay option at checkout.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ─── Bank transfer (shown at checkout + VietQR code) ──────
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# ─── Uploads (admin product images) ───────────────────────
# Keep outside the app folder on Hostinger so redeploys do not wipe uploads, e.g. /home/uXXXX/th-uploads
UPLOAD_DIR=
