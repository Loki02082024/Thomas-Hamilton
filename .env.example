# ---- Server ----
PORT=3000
NODE_ENV=production
# Public URL of the site (used for canonical/hreflang/sitemap)
SITE_URL=https://thomashamilton.vn
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Admin login (/admin) ----
ADMIN_USER=admin
# bcrypt hash — generate with: npm run hash-password -- "YourStrongPassword"
ADMIN_PASSWORD_HASH=

# ---- MySQL (Hostinger hPanel > Databases > MySQL) ----
# Leave DB_HOST empty to use the local JSON file store (data/store.json) — fine for development.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- Email notifications for new bookings (optional) ----
# Hostinger email: smtp.hostinger.com, port 465, secure=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
