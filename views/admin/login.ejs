<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Đăng nhập — THOMAS HAMILTON</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Cormorant+Garamond:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body>
<div class="login">
  <form action="/admin/login" method="post">
    <h1>Quản trị</h1>
    <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="email">Email</label><input id="email" type="email" name="email" value="<%= email %>" required autocomplete="username" autofocus></div>
    <div class="field"><label for="password">Mật khẩu</label><input id="password" type="password" name="password" required autocomplete="current-password"></div>
    <button class="btn btn--kin" type="submit" style="width:100%;justify-content:center">Đăng nhập</button>
  </form>
</div>
</body>
</html>
