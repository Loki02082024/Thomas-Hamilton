<%
locals.jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: tr(post.title),
  description: tr(post.excerpt),
  datePublished: post.date,
  author: { '@type': 'Organization', name: 'THOMAS HAMILTON' },
  publisher: { '@type': 'Organization', name: 'THOMAS HAMILTON' },
};
%>
<%- include('../partials/head') %>

<article class="section" style="padding-top:calc(var(--header-h) + 4rem)">
  <div class="container">
    <div class="article">
      <header class="article__head">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="<%= url('/') %>">THOMAS HAMILTON</a></li>
            <li><a href="<%= url('/journal') %>"><%= t.nav.journal %></a></li>
          </ol>
        </nav>
        <div class="post-card__meta"><span><%= tr(post.category) %></span><span><%= date(post.date) %></span><span><%= post.readMinutes %> <%= t.common.minRead %></span></div>
        <h1 class="h1"><%= tr(post.title) %></h1>
        <p class="lead"><%= tr(post.excerpt) %></p>
      </header>
      <div class="article__cover">
        <% if (post.image) { %><img src="<%= post.image %>" alt="" style="width:100%;height:100%;object-fit:cover"><% } else { %><div class="art art--1" style="position:absolute;inset:0" aria-hidden="true"></div><% } %>
      </div>
      <div class="prose">
        <% richText(tr(post.body)).forEach((b) => { %>
          <% if (b.type === 'h2') { %><h2><%= b.text %></h2><% } else { %><p><%= b.text %></p><% } %>
        <% }) %>
      </div>

      <div class="cta-band" style="margin-top:4rem">
        <div class="cta-band__copy">
          <span class="eyebrow"><%= t.home.ctaEyebrow %></span>
          <h2 class="h3"><%= t.home.ctaTitle %></h2>
        </div>
        <a class="btn btn--gold" href="<%= url('/book') %>"><%= t.home.ctaButton %></a>
      </div>
    </div>
  </div>
</article>

<% if (more.length) { %>
<section class="section section--alt">
  <div class="container">
    <div class="section-head"><h2 class="h2"><%= t.home.journalTitle %></h2></div>
    <div class="grid grid--3">
      <% more.forEach((p, i) => { %><%- include('../partials/post-card', { post: p, i: i + 1 }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/footer') %>
