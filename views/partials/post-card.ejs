<article class="post-card reveal" style="--d: <%= locals.i || 0 %>">
  <div class="post-card__media">
    <% if (post.image) { %>
    <img class="art" src="<%= post.image %>" alt="" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover">
    <% } else { %>
    <div class="art art--<%= ((locals.i || 0) % 3) + 1 %>" aria-hidden="true"></div>
    <% } %>
  </div>
  <div class="post-card__meta"><span><%= tr(post.category) %></span><span><%= date(post.date) %></span></div>
  <h3 class="post-card__title"><a href="<%= url('/journal/' + post.slug) %>"><%= tr(post.title) %></a></h3>
  <p class="muted"><%= tr(post.excerpt) %></p>
</article>
