<%
const title = locals.pageTitle ? `${pageTitle} — THOMAS HAMILTON` : t.meta.title;
const description = locals.pageDescription || t.meta.description;
const canonical = `${siteUrl}/${lang}${path === '/' ? '' : path}`;
%><!doctype html>
<html lang="<%= lang %>" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#0b0a09">
  <% if (siteUrl) { %>
  <link rel="canonical" href="<%= canonical %>">
  <link rel="alternate" hreflang="vi" href="<%= siteUrl %>/vi<%= path === '/' ? '' : path %>">
  <link rel="alternate" hreflang="en" href="<%= siteUrl %>/en<%= path === '/' ? '' : path %>">
  <link rel="alternate" hreflang="x-default" href="<%= siteUrl %>/vi<%= path === '/' ? '' : path %>">
  <% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="THOMAS HAMILTON">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:locale" content="<%= lang === 'vi' ? 'vi_VN' : 'en_GB' %>">
  <% if (siteUrl) { %><meta property="og:url" content="<%= canonical %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap&subset=vietnamese">
  <link rel="stylesheet" href="/css/main.css?v=1">
  <script src="/js/boot.js"></script>
  <script type="application/ld+json"><%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'THOMAS HAMILTON',
    url: siteUrl || undefined,
    telephone: site.phone,
    email: site.email,
    foundingDate: String(site.founded),
    sameAs: Object.values(site.social),
  }).replace(/</g, '\\u003c') %></script>
  <% if (locals.jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script><% } %>
</head>
<body class="<%= locals.bodyClass || '' %>">
<a class="skip-link" href="#main"><%= t.nav.skip %></a>
<%- include('header') %>
<main id="main" tabindex="-1">
